# ============================================================
# .env.example - Copie para .env e preencha os valores
# ============================================================
# NUNCA commite o .env real (contém segredos)

# Flask
# OBRIGATÓRIA, mínimo 32 caracteres: sem ela o app não sobe.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# development SÓ na sua máquina: desliga o cookie Secure (http://127.0.0.1).
# No servidor, NÃO defina FLASK_ENV: o cookie sai Secure (exige HTTPS).
FLASK_ENV=development

# Banco de dados: SQLite em instance/oficina.db (padrão, não precisa definir).
# Pra usar outro arquivo (ex.: banco de teste), aponte o caminho:
# FLASK_DATABASE=instance/oficina.db

# Debug só pra desenvolver (recarrega ao salvar; console do Werkzeug executa código).
# NUNCA ligue no servidor.
# FLASK_DEBUG=1

# Admin inicial (bootstrap_admin lê estas variáveis)
# (o iniciar.bat pergunta na primeira vez e grava aqui)
# ADMIN_EMAIL=seu@email.com
# ADMIN_SENHA_INICIAL=        # deixe vazio para sortear senha de 20 chars (recomendado)
# ADMIN_RESET_SENHA=0         # =1 para forçar reset de senha do admin existente

# Emails isentos de bloqueio por força bruta (separados por vírgula)
# EMAIL_IGNORAR_BLOQUEIOS=admin@empresa.com,gestor@empresa.com

# Limites de upload, validade do link do cliente e tentativas de login ficam no
# código e na tabela configuracao, não aqui (só o que está acima é lido do ambiente).
